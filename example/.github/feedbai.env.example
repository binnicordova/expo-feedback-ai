# What you set. Everything else is a constant — the origins, the label, the branch
# prefix and the 24-hour hold live at the top of the two workflow files and are
# documented in docs/AUTOPILOT.md.
#
#   gh variable set FEEDBAI_APP_ID    --body "your.bundle.id"
#   gh variable set FEEDBAI_MAX_IDEAS --body "1"
#   gh secret   set EAS_OWNER
#   gh secret   set EAS_PROJECT_ID


# Your app's own bundle id. It names the public feed file and keys every write, so
# this is what decides which board the automation acts on. Must match
# `expo.ios.bundleIdentifier` / `expo.android.package` in app.json — that is where
# the module itself reads it at runtime.
FEEDBAI_APP_ID=ai.feedb.example

# Optional, default 1. How many ideas the autopilot prepares per run, one PR each.
# A small diff that CI can meaningfully judge is the difference between this
# compounding and this rotting; raise it once the diffs have earned it.
FEEDBAI_MAX_IDEAS=1

# EAS, for pr-preview.yml and the two release workflows. From expo.dev.
EAS_OWNER=
EAS_PROJECT_ID=


# Also required, but they are credentials rather than configuration:
#
#   FEEDBAI_GH_TOKEN     a PAT or GitHub App token with contents: write and
#                        pull requests: write. NOT interchangeable with
#                        GITHUB_TOKEN — see docs/AUTOPILOT.md.
#   ANTHROPIC_API_KEY    bills the Claude Code action.
#   EXPO_TOKEN           bills EAS.
#
# Then rehearse the whole loop without waiting a day:
#
#   gh workflow run "FeedbAI · Autopilot"  -f dry_run=true
#   gh workflow run "FeedbAI · Autopilot"
#   gh workflow run "FeedbAI · Automerge"  -f min_age_hours=0
